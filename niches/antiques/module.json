{
  "schemaVersion": 2,
  "id": "antiques",
  "name": "Antique Flipper",
  "specialistIds": [
    "antiques",
    "books"
  ],
  "legacySpecialistIds": [
    "books"
  ],
  "defaultSpecialistId": "antiques",
  "androidPackage": "com.swish.antiqueflipper",
  "iosBundleIdentifier": "com.swish.antiqueflipper",
  "entryRoute": "/entry/antiques",
  "scannerRoute": "/antique-capture",
  "dedicatedRoutes": [
    "antique-capture.tsx",
    "antique-guides.tsx",
    "antique-condition.tsx",
    "antique-value.tsx",
    "(tabs)/antique-more.tsx"
  ],
  "responsibilities": "Antique and collectible identification, maker/period/material, provenance evidence, condition and valuation.",
  "sharedCapabilities": [
    "auth",
    "tenant-and-subscription",
    "inventory-persistence",
    "ebay-oauth-listings-drafts-orders-sync",
    "shared-ai-orchestration",
    "learning-and-prediction",
    "reusable-ui-primitives"
  ],
  "isolationModel": "shared-core-with-registered-niche-configuration",
  "verification": {
    "registrySource": "niche-modules.json",
    "specialistOwnership": "canonical-specialist-and-legacy-aliases",
    "runtimeBoundary": "separate-branded-entry-and-build-identity",
    "dataBoundary": "tenant-and-niche-scoped-authorization-required",
    "status": "audited-contract; end-to-end runtime isolation still requires live verification"
  }
}
